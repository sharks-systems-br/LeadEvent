
{
  "openapi": "3.1.0",
  "info": {
    "title": "LeadEvent API",
    "version": "1.0.0",
    "description": "Contrato do painel de cadastros do LeadEvent. Os exemplos de Company e Influencer são os mesmos usados pelo frontend em modo demonstração. Rotas marcadas com x-status: planned ainda não existem no backend.",
    "contact": {
      "name": "SSB - Sharks Systems Brazil"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5050",
      "description": "Ambiente local"
    }
  ],
  "x-pending": {
    "auth": "O login atual redireciona sem token. A intenção é proteger as rotas do painel com bearerAuth.",
    "pagination": "Os GETs retornam a lista completa. Paginação e filtros são aplicados no frontend e não enviam query params.",
    "status": "Aprovar ou recusar altera apenas o estado local. O backend precisa de status persistido e das rotas PATCH de status."
  },
  "tags": [
    {
      "name": "Empresas",
      "description": "Cadastros de empresas patrocinadoras."
    },
    {
      "name": "Influencers",
      "description": "Cadastros de creators."
    },
    {
      "name": "Arquivos",
      "description": "Upload temporário de vídeo."
    }
  ],
  "paths": {
    "/companies": {
      "get": {
        "tags": [
          "Empresas"
        ],
        "operationId": "listCompanies",
        "summary": "Lista os cadastros de empresas",
        "description": "Retorna todos os cadastros, do mais recente para o mais antigo. O campo status é opcional na resposta; quando ausente, o frontend assume PENDING.",
        "x-status": "implemented",
        "responses": {
          "200": {
            "description": "Lista de empresas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Company"
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "tags": [
          "Empresas"
        ],
        "operationId": "createCompany",
        "summary": "Registra uma empresa",
        "description": "Recebe o payload do formulário de empresa. O Turnstile é validado pelo header cf-turnstile-response quando habilitado.",
        "x-status": "implemented",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCompanyRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cadastro criado"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/companies/{id}": {
      "get": {
        "tags": [
          "Empresas"
        ],
        "operationId": "getCompany",
        "summary": "Busca uma empresa pelo id",
        "x-status": "implemented",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "200": {
            "description": "Empresa encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Company"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/companies/{id}/status": {
      "patch": {
        "tags": [
          "Empresas"
        ],
        "operationId": "updateCompanyStatus",
        "summary": "Aprova ou recusa uma empresa",
        "description": "Altera o status de triagem do cadastro. O frontend ainda não chama esta rota; hoje a mudança é local.",
        "x-status": "planned",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateLeadStatusRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Status atualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Company"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/influencers": {
      "get": {
        "tags": [
          "Influencers"
        ],
        "operationId": "listInfluencers",
        "summary": "Lista os cadastros de influencers",
        "description": "Retorna todos os cadastros, do mais recente para o mais antigo. O campo status é opcional na resposta; quando ausente, o frontend assume PENDING.",
        "x-status": "implemented",
        "responses": {
          "200": {
            "description": "Lista de influencers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Influencer"
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "tags": [
          "Influencers"
        ],
        "operationId": "createInfluencer",
        "summary": "Registra um influencer",
        "description": "Recebe o payload do formulário. O vídeo chega por filePath, após POST /files, ou por fileUrl quando o link é externo. O Turnstile é validado pelo header cf-turnstile-response quando habilitado.",
        "x-status": "implemented",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInfluencerRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cadastro criado"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/influencers/{id}": {
      "get": {
        "tags": [
          "Influencers"
        ],
        "operationId": "getInfluencer",
        "summary": "Busca um influencer pelo id",
        "x-status": "implemented",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "200": {
            "description": "Influencer encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Influencer"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/influencers/{id}/status": {
      "patch": {
        "tags": [
          "Influencers"
        ],
        "operationId": "updateInfluencerStatus",
        "summary": "Aprova ou recusa um influencer",
        "description": "Altera o status de triagem do cadastro. O frontend ainda não chama esta rota; hoje a mudança é local.",
        "x-status": "planned",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateLeadStatusRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Status atualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Influencer"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/files": {
      "post": {
        "tags": [
          "Arquivos"
        ],
        "operationId": "uploadFile",
        "summary": "Envia um vídeo temporário",
        "description": "Recebe o arquivo e devolve o filePath usado em POST /influencers. Limite de 80 MB e 2 minutos, validados no frontend quando possível.",
        "x-status": "implemented",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Arquivo aceito",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Autenticação planejada para as rotas do painel. Ainda não implementada no frontend nem no backend."
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Identificador UUID do cadastro.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Erro da API",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "LeadStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "APPROVED",
          "REJECTED"
        ],
        "description": "Status de triagem do cadastro."
      },
      "Disponibility": {
        "type": "string",
        "enum": [
          "MORNING",
          "AFTERNOON",
          "END_OF_THE_DAY",
          "ANY_TIME",
          "BY_EMAIL"
        ],
        "description": "Disponibilidade para reunião informada pela empresa."
      },
      "FollowerRange": {
        "type": "string",
        "enum": [
          "_UP_TO_10K",
          "_10K_TO_50K",
          "_50K_TO_100K",
          "_100K_TO_500K",
          "_500K_TO_1M",
          "_GT_1M"
        ],
        "description": "Faixa de seguidores informada pelo influencer."
      },
      "SocialMedia": {
        "type": "string",
        "enum": [
          "INSTAGRAM",
          "TIKTOK",
          "YOUTUBE",
          "FACEBOOK",
          "LINKEDIN",
          "TWITCH",
          "PINTEREST",
          "THREADS",
          "SITE",
          "X"
        ],
        "description": "Plataforma de uma rede social adicional."
      },
      "PartnershipFormat": {
        "type": "object",
        "required": [
          "format"
        ],
        "properties": {
          "format": {
            "type": "string",
            "maxLength": 30,
            "description": "Rótulo do formato de parceria.",
            "examples": [
              "Post patrocinado"
            ]
          }
        }
      },
      "SocialMediaLink": {
        "type": "object",
        "required": [
          "socialMedia",
          "link"
        ],
        "properties": {
          "socialMedia": {
            "$ref": "#/components/schemas/SocialMedia"
          },
          "link": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "Company": {
        "type": "object",
        "required": [
          "id",
          "tradeName",
          "cnpj",
          "contactEmail",
          "personName",
          "socialMedia",
          "reason",
          "disponibility",
          "partnershipFormats",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "tradeName": {
            "type": "string",
            "maxLength": 150
          },
          "cnpj": {
            "type": "string",
            "pattern": "^\\d{14}$",
            "description": "Somente dígitos.",
            "examples": [
              "12345678000190"
            ]
          },
          "contactEmail": {
            "type": "string",
            "format": "email"
          },
          "personName": {
            "type": "string",
            "maxLength": 150
          },
          "socialMedia": {
            "type": "string",
            "description": "Instagram, @handle ou site informado no cadastro."
          },
          "reason": {
            "type": "string",
            "maxLength": 600
          },
          "disponibility": {
            "$ref": "#/components/schemas/Disponibility"
          },
          "partnershipFormats": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PartnershipFormat"
            }
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/LeadStatus"
              }
            ],
            "default": "PENDING",
            "description": "Opcional na resposta atual; o frontend assume PENDING quando ausente."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        },
