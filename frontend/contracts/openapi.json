      "CreateCompanyRequest": {
        "type": "object",
        "required": [
          "tradeName",
          "cnpj",
          "contactEmail",
          "personName",
          "socialMedia",
          "reason",
          "partnershipFormats",
          "confirmContact",
          "disponibility"
        ],
        "properties": {
          "tradeName": {
            "type": "string",
            "maxLength": 150
          },
          "cnpj": {
            "type": "string",
            "pattern": "^\\d{14}$"
          },
          "contactEmail": {
            "type": "string",
            "format": "email"
          },
          "personName": {
            "type": "string",
            "maxLength": 150
          },
          "socialMedia": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "maxLength": 600
          },
          "partnershipFormats": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "maxLength": 30
            }
          },
          "confirmContact": {
            "const": true
          },
          "disponibility": {
            "$ref": "#/components/schemas/Disponibility"
          }
        }
      },
      "CreateInfluencerRequest": {
        "type": "object",
        "required": [
          "name",
          "instagram",
          "phone",
          "reason",
          "niche",
          "state",
          "city",
          "followerRange",
          "confirmContact"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 150
          },
          "instagram": {
            "type": "string",
            "maxLength": 100
          },
          "phone": {
            "type": "string",
            "maxLength": 20
          },
          "reason": {
            "type": "string",
            "maxLength": 600
          },
          "niche": {
            "type": "string",
            "maxLength": 30
          },
          "state": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          },
          "city": {
            "type": "string",
            "maxLength": 150
          },
          "followerRange": {
            "$ref": "#/components/schemas/FollowerRange"
          },
          "confirmContact": {
            "const": true
          },
          "socialMedias": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SocialMediaLink"
            }
          },
          "filePath": {
            "type": "string",
            "description": "Caminho temporário devolvido por POST /files."
          },
          "fileUrl": {
            "type": "string",
            "format": "uri",
            "description": "Link externo de vídeo. Usado quando não há filePath."
          }
        }
      },
      "UpdateLeadStatusRequest": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/LeadStatus"
          }
        }
      },
      "FileUploadResponse": {
        "type": "object",
        "required": [
          "filePath"
        ],
        "properties": {
          "filePath": {
            "type": "string"
          }
        },
        "examples": [
          {
            "filePath": "tmp/2f1c9a7e-video.mp4"
          }
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "statusCode",
          "message"
        ],
        "properties": {
          "statusCode": {
            "type": "number"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
