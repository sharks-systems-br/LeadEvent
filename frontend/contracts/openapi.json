      "Influencer": {
        "type": "object",
        "required": [
          "id",
          "name",
          "instagram",
          "phone",
          "reason",
          "niche",
          "videoUrl",
          "state",
          "city",
          "followerRange",
          "socialMedias",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "name": {
            "type": "string",
            "maxLength": 150
          },
          "instagram": {
            "type": "string",
            "maxLength": 100,
            "description": "Handle sem @.",
            "examples": [
              "marianacosta"
            ]
          },
          "phone": {
            "type": "string",
            "maxLength": 20,
            "description": "Somente dígitos, com DDD.",
            "examples": [
