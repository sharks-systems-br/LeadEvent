DATABASE_URL=""

PORT=5050
NODE_ENV=production

# Origem(ns) do frontend separadas por vírgula
FRONTEND_URL="http://localhost:3000"

# Número de proxies na frente da API. Use 1 em Nginx, Render, Railway e similares.
TRUST_PROXY=1

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_DRIVE_FOLDER_ID=""

DISCORD_WEBHOOK_URL=""
DISCORD_ROLE_ID=""

# Usuários admins separados por "|" e com username separado da senha por ":"
ADMIN_USERS="username:password|username2:wordpass"

JWT_SECRET=""

# Uma string de muito alta entropia
EMERGENCY_TOKEN=""

# Sem esta chave o Turnstile fica desligado e os formulários aceitam qualquer envio
TURNSTILE_SECRET_KEY=""
